<!-- res/drawable/custom_marker.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Transparent center circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" /> <!-- Fully transparent -->
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>

    <!-- Border circle -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="7dp"
                android:color="@color/route_reached" /> <!-- Customize the border color -->
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
</layer-list>
