<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_scan.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:gravity="start"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <!-- Title Layout -->
        <LinearLayout
            android:id="@+id/titlelayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_store_title"
                android:textStyle="bold"
                android:textColor="@color/appColor"
                android:textSize="28sp"
                android:layout_gravity="center_horizontal"/>
        </LinearLayout>

        <!-- Select Store Layout -->
        <LinearLayout
            android:id="@+id/selectStoreLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"

                android:hint="@string/retail_store"
                app:layout_constraintEnd_toStartOf="@id/imageView"
                android:layout_weight="1">
                <AutoCompleteTextView
                    android:id="@+id/autocompleteDc"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:inputType="none"
                    android:focusable="false"
                    android:paddingLeft="@dimen/_10sdp"
                    android:textSize="20dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    />
            </com.google.android.material.textfield.TextInputLayout>
            <ImageView
                android:id="@+id/confirmStore"
                android:layout_width="40dp"
                android:layout_height="40dp"

                android:src="@drawable/vc_add_task_52"/>
        </LinearLayout>

        <TextView
            android:id = "@+id/storeAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="@dimen/_11sdp"
            android:hint="Address:"
            app:layout_constraintTop_toBottomOf="@id/selectStoreLayout"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:textColor="@color/appColor"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id = "@+id/storeCodeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/codeColor"
                android:text="@string/code"
                />
            <TextView
                android:id = "@+id/storeCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/codeColor"
                />
        </LinearLayout>

        <TextView
            android:id="@+id/labelSelectedStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/storeCode"
            app:layout_constraintStart_toStartOf="parent"
            android:text="@string/stores_in_trip"
            android:textSize="@dimen/_13sdp"
            android:textStyle="bold"
            android:maxLength="50"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            style="@style/TextAppearance.AppCompat.Subhead"
            />
        <ListView
            android:id="@+id/listStores"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelSelectedStore"
            app:layout_constraintBottom_toTopOf="@id/backButton"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/listview_border"
            />
        <!-- Back Button -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/back_button"
            android:textColor="@color/black"
            android:background="@drawable/underline"
            android:paddingTop="10dp"
            android:paddingRight="20dp"
            android:paddingLeft="20dp"
            android:paddingBottom="2dp"/>
    </LinearLayout>

</ScrollView>
