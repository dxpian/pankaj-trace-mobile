<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_scan.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:gravity="start">

    <!-- Text View -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/load_option_name"
        android:textStyle="bold"
        android:layout_marginTop="30dp"
        android:textColor="@color/appColor"
        android:layout_marginStart="10dp"
        android:textSize="28sp"
        />
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/linedialoge"
        android:layout_marginTop="10dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/from"
            android:layout_marginTop="30dp"
            android:layout_marginStart="10dp"
            android:textSize="18sp"
            />
        <TextView
            android:id="@+id/label_dc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dist_center"
            android:layout_marginTop="30dp"
            android:layout_marginStart="10dp"
            android:textSize="18sp"
            android:textColor="@color/appColor"

            />
    </LinearLayout>

    <TextView
        android:id="@+id/label_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_cart"
        android:layout_marginTop="0dp"
        android:layout_marginStart="10dp"
        android:textSize="18sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:gravity="center">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:text="@string/IOT"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/iot_tag"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:inputType="none"
                android:focusable="false"
                android:layout_weight="1"
                android:textSize="18sp"
                android:maxLines="1"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:background="@drawable/border_skyblue"/>
            <ImageView
                android:id="@+id/scanQr"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/vc_scanner_48">
            </ImageView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:gravity="center">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:text="@string/product"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/product_desc"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:inputType="none"
                android:focusable="false"
                android:layout_weight="1"
                android:textSize="18sp"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:gravity="center_vertical"
                android:background="@drawable/border_skyblue"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Button Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/addcart"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/skyblue"
            android:textColor="@color/white"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:text="@string/load_option_name"
        />

    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="start|bottom"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp">

        <!-- Back Button -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:textColor="@color/black"
            android:background="@drawable/underline"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="@string/back_button" />

    </LinearLayout>
</LinearLayout>
