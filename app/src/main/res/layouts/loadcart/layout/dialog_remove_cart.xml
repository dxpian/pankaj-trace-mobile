<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_scan.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:gravity="start">

    <!-- Text View -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="30dp"
        android:text="@string/unload_option_name"
        android:textColor="@color/appColor"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/linedialoge"
        android:layout_marginTop="10dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/to"
                android:layout_marginTop="30dp"
                android:layout_marginStart="10dp"
                android:textSize="18sp"
                />
            <TextView
                android:id="@+id/label_dc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distribution center"
                android:layout_marginTop="30dp"
                android:layout_marginStart="10dp"
                android:textSize="18sp"
                android:textColor="@color/appColor"

                />
        </LinearLayout>

        <TextView
            android:id="@+id/label_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_cart"
            android:layout_marginTop="0dp"
            android:layout_marginStart="8dp"
            android:textSize="18sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:gravity="center">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:text="@string/IOT"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_gravity="center_vertical">

                <AutoCompleteTextView
                    android:id="@+id/spinner_tag"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="none"
                    android:focusable="false"
                    android:layout_marginLeft="8dp"
                    android:paddingLeft="@dimen/_10sdp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/border_skyblue"
                    android:dropDownHeight="wrap_content"

                    />
            </com.google.android.material.textfield.TextInputLayout>
            <ImageView
                android:id="@+id/scanQr"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/vc_scanner_48">
            </ImageView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:gravity="center">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:text="@string/IOT"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/product_desc"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:inputType="none"
                android:focusable="false"
                android:layout_weight="1"
                android:textSize="18sp"
                android:maxLines="1"
                android:paddingLeft="10dp"
                android:background="@drawable/border_skyblue"/>
        </LinearLayout>


    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirm_unload"
        android:textSize="24sp"
        android:gravity="center"
        android:textColor="@color/black"
        android:textStyle="bold"/>
    <!-- Button Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <!-- Scan Now Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/confirmDelete"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:background="@drawable/border_skyblue"
            android:textColor="@color/appColor"
            android:layout_weight="1"
            android:textSize="@dimen/_12ssp"
            android:text="@string/unload_option_name"
            android:layout_marginStart="20dp"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:textSize="@dimen/_12ssp"
            android:background="@drawable/border_skyblue"
            android:textColor="@color/appColor"
            android:layout_weight="1"
            android:text="@string/ok" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="start|bottom"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"
        >

        <!-- Back Button -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:background="@drawable/underline"
            android:layout_marginEnd="20dp"
            android:text="Back" />

    </LinearLayout>
</LinearLayout>
