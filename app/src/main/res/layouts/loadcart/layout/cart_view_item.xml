<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cart_item_background"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"

    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <ImageView
                android:id="@+id/entityStatus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@mipmap/qr_cart"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintTop_toBottomOf="parent"
                android:layout_margin="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                />
            <TextView
                android:id = "@+id/cartLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/entityStatus"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginLeft="10dp"
                android:gravity="center_vertical"
                android:text="@string/cart"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
            />
            <TextView
                android:id="@+id/cartIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/cartLabel"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginLeft="10dp"
                android:gravity="center_vertical"
                android:text="0"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
            />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cartDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:background="@drawable/cart_item_detail_background">
            <TextView
                android:id="@+id/labelMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginLeft="10dp"
                android:gravity="center_vertical"
                android:text="MAC:"
                android:textSize="@dimen/text_size_medium"
                android:textStyle=""
                />


            <TextView
                android:id="@+id/cartMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/labelMac"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginLeft="10dp"
                android:gravity="center_vertical"
                android:text="00:00:00:00"
                android:textSize="@dimen/text_size_medium"
                android:textStyle=""
                />

        </androidx.constraintlayout.widget.ConstraintLayout>





    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

