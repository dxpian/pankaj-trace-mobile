<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <LinearLayout
        android:id="@+id/layoutMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@id/iconNotify"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="5dp"
        android:orientation="vertical"
        >

        <TextView
            android:id="@+id/notifyTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2024-08-05"
            android:layout_margin="2dp"
            android:textSize="13dp"
            android:maxLines="1"
            android:ellipsize="end"

            />
        <TextView
            android:id="@+id/notifyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:hint="notification message"
            android:textSize="14dp"
            android:layout_margin="2dp"
            android:textStyle="bold"/>

    </LinearLayout>

    <TextView
        android:id="@+id/notifyLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:text="@string/view_trip"
        android:layout_margin="8dp"
        android:textColor="@color/appColor"
        android:clickable="true"
        android:autoLink="none"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/layoutMain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iconNotify"
        app:layout_constraintBottom_toTopOf="@id/sticker"
        />

    <ImageView
        android:id="@+id/iconNotify"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:padding="11dp"
        android:src="@mipmap/bell_read"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sticker"
        app:layout_constraintEnd_toStartOf="@id/removeNotify"
        />

    <ImageView
        android:id="@+id/removeNotify"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sticker"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="10dp"
        android:src="@drawable/vc_trash_48"/>
    <View
        android:id="@+id/sticker"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/darkGray2"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="5dp"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="1dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>