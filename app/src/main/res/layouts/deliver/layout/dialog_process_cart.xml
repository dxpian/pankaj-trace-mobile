<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_scan.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="500dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/white">

    <!-- Text View -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_overview"
        android:textStyle="bold"
        android:layout_marginTop="30dp"
        android:textColor="@color/appColor"
        android:textSize="28sp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/process_in_store"
        android:layout_margin="5dp"
        android:gravity="center"
        android:textSize="18sp"
        />
    <TextView
        android:id="@+id/labelStore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/retail_store"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/brown"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:gravity="center">
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:background="@drawable/border_skyblue"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/midcart"/>
            <TextView
                android:id="@+id/cartLoaded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="0"
                android:textSize="40sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/load_cart_2"
                android:gravity="center"
                android:textSize="18sp"
                android:textColor="@color/black"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:background="@drawable/border_skyblue"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/midcart2"/>
            <TextView
                android:id="@+id/cartEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="0"
                android:textSize="40sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_cart_2"
                android:gravity="center"
                android:textSize="18sp"
                android:textColor="@color/black"/>
        </LinearLayout>
    </LinearLayout>

    <TextView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/truck_cart_overview"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:textSize="16sp"
    />

    <!-- Button Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal">

        <!-- Scan Now Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cart_deliver"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@drawable/skyblue"
            android:textColor="@color/white"
            android:text="@string/deliver_cart"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cart_pickup"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/skyblue"
            android:textColor="@color/white"
            android:text="@string/pickup_cart" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="end|bottom"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="10dp">

        <!-- Back Button -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:textColor="@color/black"
            android:background="@drawable/underline"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="@string/back_button" />

    </LinearLayout>
</LinearLayout>
